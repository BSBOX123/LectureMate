# cp .env.example .env 후 환경에 맞게 수정 (SPEC §5.1)

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lecturemate
SPRING_BOOT_WEBHOOK_URL=http://localhost:8080/internal/v1
# Spring Boot 와 동일한 값이어야 한다
INTERNAL_API_SECRET=local-dev-internal-secret

# 로컬 개발 시 small/base 등 작은 모델로 바꿔 테스트 가능 (정식 값: large-v3)
WHISPER_MODEL_NAME=large-v3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# 슬라이드-음성 정렬과 RAG 에 필요. false 로 두면 임베딩과 정렬을 건너뛴다 (모델 약 2GB 다운로드 회피)
EMBEDDING_ENABLED=true

# LLM: 개발 단계에서는 EC2 의 Ollama 를 SSH 터널로 연결
#   로컬 ollama 컨테이너가 11434 를 쓰고 있으므로 터널은 11435 로 연다:
#   ssh -N -L 11435:localhost:11434 <ec2-user>@<ec2-host>
#   → LLM_BACKEND_URL=http://localhost:11435/v1
LLM_BACKEND_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:14b-instruct
# Mac 로컬 개발: 네이티브 Ollama(brew install ollama) + 작은 모델 사용을 권장
#   LLM_MODEL_NAME=qwen2.5:7b-instruct   (실측 9 tok/s, 슬라이드 1장당 약 18초)
#   Docker 컨테이너의 Ollama 는 0.3 tok/s 로 사실상 사용 불가
# 슬라이드 1장당 LLM 타임아웃(초)
LLM_TIMEOUT_SECONDS=180

# 선택 항목 (기본값 사용 시 생략 가능)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_ECHO=false
# MODEL_CACHE_DIR=/path/to/model/cache
