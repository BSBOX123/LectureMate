# cp .env.prod.example .env.prod 후 실제 값으로 채운다 (.env.prod 는 커밋하지 않는다)

# 공개 주소 (프론트 빌드와 CORS, 쿠키에 사용)
PUBLIC_ORIGIN=https://lecturemate.example.com

# DB
POSTGRES_USER=lecturemate
POSTGRES_PASSWORD=<강력한 비밀번호>
POSTGRES_DB=lecturemate

# 시크릿 (openssl rand -base64 48 로 생성)
JWT_SECRET=<32바이트 이상 랜덤 값>
INTERNAL_API_SECRET=<랜덤 값>

# 모델
WHISPER_MODEL_NAME=large-v3
LLM_MODEL_NAME=qwen2.5:14b-instruct
